# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:2956"

# PYTHON_PATH: Path to the Python executable that has the ML packages installed.
# Required for the /api/analyze endpoint to run model predictions.
# Example: /usr/bin/python3 or /path/to/venv/bin/python
PYTHON_PATH="python3"

# OLLAMA (local LLM) — Clinical Huddle summaries via deepseek-v4-flash
# Ollama runs on localhost:11434 by default; if using a different port, update below.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-v4-flash:cloud
